# Beispielkonfiguration der externen Demo-Instanz von Projekt X (Etappe 3).
# Kopie als .env.demo anlegen und Werte eintragen. Die Datei .env.demo kommt nie in Git.
# Nur Beispieldaten! Eigene Datenbank und eigene Rolle ohne Rechte auf projektx_dev.
PX_INSTANCE=demo
DJANGO_DEBUG=0

DB_NAME=projektx_demo
DB_USER=projektx_demo
DB_PASSWORD=HIER_EINTRAGEN
DB_HOST=localhost
DB_PORT=5432

# Eigener zufälliger Schlüssel (mind. 50 Zeichen), nicht derselbe wie in .env
DJANGO_SECRET_KEY=HIER_EINTRAGEN
# Gemeinsames Passwort der Demo-Konten aus seed_demo (stark wählen)
DEMO_PASSWORD=HIER_EINTRAGEN

# Tunneladresse eintragen, z. B. abcd1234-8100.euw.devtunnels.ms
DJANGO_ALLOWED_HOSTS=HIER_TUNNELADRESSE,127.0.0.1,localhost
# Tunnel-Adresse UND http://localhost:<PX_PORT>: Dev Tunnels schreibt den Origin-Header des Browsers auf localhost um
CSRF_TRUSTED_ORIGINS=https://HIER_TUNNEL_ADRESSE,http://localhost:8100

# Hinter dem Tunnel: X-Forwarded-Proto/-For auswerten (nur Verbindungen von 127.0.0.1)
PX_BEHIND_PROXY=1
# HSTS für die Demo bewusst kurz (Sekunden), ohne preload
SECURE_HSTS_SECONDS=3600
# 1 = HTTP auf HTTPS umleiten; nur auf 0 setzen, falls der Tunnel kein X-Forwarded-Proto sendet
PX_SSL_REDIRECT=1

# Startskript scripts\demo.ps1
PX_PORT=8100
PX_TUNNEL_ID=HIER_TUNNEL_ID
