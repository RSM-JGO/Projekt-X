# Beispielkonfiguration für die lokale Entwicklung von Projekt X.
# Kopie als .env anlegen und Werte eintragen. Die Datei .env kommt nie in Git.
DB_NAME=projektx_dev
DB_USER=projektx
DB_PASSWORD=HIER_EINTRAGEN
DB_HOST=localhost
DB_PORT=5432

# Django: eigener zufälliger Schlüssel je Umgebung, nie teilen
DJANGO_SECRET_KEY=HIER_EINTRAGEN
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Nur Entwicklung: gemeinsames Passwort der Beispielkonten aus seed_demo
DEMO_PASSWORD=HIER_EINTRAGEN
